# Craft site Freeform talks to (no trailing slash)
# Local proxy mode: leave empty and set CRAFT_PROXY_TARGET for Vite/Nuxt proxy
# Vercel / other host: set to your Craft URL
VITE_FREEFORM_BASE_URL=https://demo.solspace.com

# Optional local-only: Vite proxies /freeform → this when VITE_FREEFORM_BASE_URL is empty
# CRAFT_PROXY_TARGET=https://demo.solspace.com

# Default form handle
VITE_FREEFORM_HANDLE=contact

# Optional — GraphQL tab
# VITE_GRAPHQL_PATH=/actions/graphql/api
# VITE_GRAPHQL_TOKEN=your-craft-graphql-token

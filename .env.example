# Craft / Freeform site the Vite proxy talks to (defaults to https://site.ddev.site)
CRAFT_PROXY_TARGET=https://site.ddev.site

# Shown in the UI / used as the default form handle (change to your Freeform form handle)
VITE_FREEFORM_HANDLE=contact

# Dev server port
PORT=3000

# Optional — GraphQL tab (Craft schema token: Freeform form read + submission create + site access)
# VITE_GRAPHQL_PATH=/actions/graphql/api
# VITE_GRAPHQL_TOKEN=your-craft-graphql-token
